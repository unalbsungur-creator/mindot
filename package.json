{
  "name": "mindot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "build:cf:staging": "tsx src/lib/deploy/buildStaging.ts",
    "test:db:tokens": "node scripts/token-db-test.mjs src/features/tokens/repository.db.test.ts",
    "test:db:refunds": "node scripts/token-db-test.mjs src/features/tokens/refund-actions.db.test.ts",
    "test:db:account-deletion": "node scripts/token-db-test.mjs src/features/users/repository.db.test.ts",
    "test:db:admin-lockout": "node scripts/token-db-test.mjs src/features/users/adminLockout.db.test.ts",
    "test:db:messages": "node scripts/token-db-test.mjs src/features/messages/textAlign.db.test.ts",
    "test:db:home": "node scripts/token-db-test.mjs src/features/messages/homeHero.db.test.ts",
    "test:db:wall-consent": "node scripts/token-db-test.mjs src/features/users/wallConsent.db.test.ts",
    "test:db:quotes": "node scripts/token-db-test.mjs src/features/messages/quoteAttribution.db.test.ts",
    "test:db:quote-backfill": "node scripts/token-db-test.mjs src/features/messages/quoteBackfill.db.test.ts",
    "test:db:wall-share": "node scripts/token-db-test.mjs src/features/messages/wallShareNotes.db.test.ts",
    "test:db:alerts": "node scripts/token-db-test.mjs src/features/moderation/alerts/repository.db.test.ts",
    "test:db:invitations": "node scripts/token-db-test.mjs src/features/invitations/repository.db.test.ts",
    "test:memories": "tsx --experimental-test-module-mocks --test src/features/memories/captureMode.test.tsx src/features/profile/memoryLibrary.test.tsx",
    "test:wall-links": "tsx --experimental-test-module-mocks --test src/features/profile/publicWallLinks.test.tsx",
    "test:wall-consent": "tsx --experimental-test-module-mocks --test src/features/profile/wallConsent.test.tsx",
    "test:wall-share": "tsx --experimental-test-module-mocks --test src/features/sharing/wallShareImage.test.tsx",
    "test:admin-orders": "tsx --experimental-test-module-mocks --test \"src/app/admin/orders/*/page.test.tsx\"",
    "test:shopier-admin": "tsx --experimental-test-module-mocks --test src/features/tokens/components/RecordShopierPurchaseDialog.test.tsx",
    "test:tokens-page": "tsx --experimental-test-module-mocks --test src/app/tokens/page.test.tsx",
    "test": "node scripts/unit-tests.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:staging": "tsx src/lib/db/migrateStaging.ts",
    "db:migrate:production:guarded": "tsx src/lib/db/migrateProduction.ts",
    "db:quotes:backfill": "tsx src/lib/db/quoteBackfill.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:verify": "tsx src/lib/db/verify.ts",
    "db:create-admin": "tsx src/lib/db/createAdmin.ts",
    "db:repair-placements": "tsx src/lib/db/repairPlacements.ts",
    "db:recalibrate-sequence": "tsx src/lib/db/recalibratePlacementSequence.ts",
    "auth:apple-secret": "tsx src/lib/createAppleClientSecret.ts",
    "assets:validate-standard": "tsx src/lib/assets/validateStandardAssets.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "drizzle-orm": "^0.45.2",
    "fontkit": "^2.0.4",
    "jose": "6.2.10",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wrangler": "^4.162.0"
  }
}
