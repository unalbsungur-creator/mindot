{
  "name": "mindot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "build:cf:staging": "tsx src/lib/deploy/buildStaging.ts",
    "test": "tsx --test src/lib/appEnvironment.test.ts src/lib/assets/standardAssetValidation.test.ts src/features/memories/lib/pdfDownloadDate.test.ts src/features/memories/lib/imageSize.test.ts src/features/memories/config/pdfBackgrounds.test.ts src/features/messages/lib/messageLength.test.ts src/features/notes/config/standardCards.test.ts src/features/auth/service.test.ts src/features/messages/service.test.ts src/features/reports/service.test.ts src/features/blocks/service.test.ts src/features/users/accountDeletion.test.ts src/lib/env.test.ts src/features/auth/lib/mobileAccessToken.test.ts src/features/auth/lib/refreshToken.test.ts src/features/auth/mobileService.test.ts src/app/api/mobile/lib/meHandler.test.ts src/app/api/board/lib/boardHandler.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:staging": "tsx src/lib/db/migrateStaging.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:verify": "tsx src/lib/db/verify.ts",
    "db:create-admin": "tsx src/lib/db/createAdmin.ts",
    "db:repair-placements": "tsx src/lib/db/repairPlacements.ts",
    "db:recalibrate-sequence": "tsx src/lib/db/recalibratePlacementSequence.ts",
    "auth:apple-secret": "tsx src/lib/createAppleClientSecret.ts",
    "assets:validate-standard": "tsx src/lib/assets/validateStandardAssets.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "drizzle-orm": "^0.45.2",
    "fontkit": "^2.0.4",
    "jose": "6.2.10",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wrangler": "^4.128.0"
  }
}
