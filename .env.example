# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Application (Required) ---
# The single public site URL variable (getAppUrl() in src/lib/env.ts).
# Public canonical origin, without a trailing path. Used for metadata,
# canonical links, Open Graph/JSON-LD URLs, the sitemap, and robots.txt.
# It contains no secret and may be exposed. Production value:
# https://mind-ot.com — never the localhost default below.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js canonical origin. Keep this equal to NEXT_PUBLIC_APP_URL in normal
# deployments — getAppUrl() reads this only as a fallback when
# NEXT_PUBLIC_APP_URL is unset. Production value: https://mind-ot.com
AUTH_URL=http://localhost:3000
# If a production deployment somehow sets neither of the above, getAppUrl()
# falls back to the hardcoded PRODUCTION_SITE_URL in src/lib/siteConfig.ts
# (https://mind-ot.com) rather than ever generating a localhost URL — but
# always set NEXT_PUBLIC_APP_URL explicitly in the real deployment env
# rather than relying on that fallback.

# --- Authentication: Google OAuth (Required) ---
# Without these, sign-in fails at request time with a clear error — the
# rest of the app (homepage, board reading, legal pages) still works.
# Create credentials at https://console.cloud.google.com/apis/credentials
#   1. Create an OAuth 2.0 Client ID of type "Web application".
#   2. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#      Production: https://mind-ot.com/api/auth/callback/google
#   3. Request only the default "openid email profile" scopes — MINDOT
#      never asks for Gmail or any other Google data.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Auth.js session encryption (Required) ---
# Generate one with: npx auth secret
# (or: openssl rand -base64 33)
AUTH_SECRET=

# --- Database (Required) ---
# Any real Postgres works: a local install, Docker, or a free-tier hosted
# instance (Neon, Supabase, Railway, etc). See README.md for setup options.
# Required for anything that touches messages/users/memories/etc — the
# homepage and legal pages don't need it, but sign-in, writing, moderation,
# and every EPIC-013 dev-testing step below do.
DATABASE_URL=postgresql://user:password@localhost:5432/mindot

# --- Initial administrator bootstrap (Required to test admin locally) ---
# Comma-separated emails. The FIRST time one of these emails signs in with
# Google, that user is created with role "admin". Changing this list later
# does not retroactively promote or demote anyone already in the database
# — ongoing admin management is done via the `role` column (or a future
# admin-management UI), not this variable. See CLAUDE.md.
# Set this to YOUR OWN Google account's email before signing in if you want
# to test the admin experience locally — `npm run db:seed`'s admin@mindot.dev
# is backing data only (its id isn't a real Google account), not something
# you can actually sign in as. See "Development seed data" in CLAUDE.md.
ADMIN_EMAILS=

# --- AI pre-moderation provider (Optional) ---
# Unset (or "dev-fallback") uses the honest, non-AI heuristic fallback — no
# real provider is integrated yet, and local testing works fully without
# setting this. See src/features/moderation/service.ts.
# AI_MODERATION_PROVIDER=dev-fallback

# --- Invitation email delivery (Optional) ---
# Unset (or "dev-fallback") never actually sends anything — creating an
# invitation with a recipient email still works, and the admin sees a
# clear "e-mail gönderimi yapılandırılmamış" status rather than a fake
# success. See src/features/email/service.ts.
# EMAIL_PROVIDER=resend
# Only read when EMAIL_PROVIDER=resend. Get a key at https://resend.com/api-keys
# RESEND_API_KEY=
# The verified "from" address/domain in your Resend account.
# EMAIL_FROM=MINDOT <invites@mind-ot.com>

# --- Commerce: Memory / print / physical gift (Optional) ---
# Architecturally prepared, not live-integrated — see "Memory preservation
# architecture" in CLAUDE.md. Both fall back to sensible defaults if unset,
# and local testing of the digital/physical flows works fully without
# setting either (see the EPIC 013 checklist in CLAUDE.md for how).

# The physical fulfilment partner. Defaults to https://dilekkutum.com/ if unset.
# DILEKKUTUM_URL=https://dilekkutum.com/

# Where a buyer purchases the digital frame product. No real Shoppier
# product exists yet, so this is empty by default — the purchase UI
# explains that rather than sending anyone to a broken link.
# SHOPPIER_PRODUCT_URL=

# --- Social links (Optional, EPIC 008) ---
# MINDOT's own social accounts. Unset by default (no real account exists
# yet on any of these) — the footer only links to a platform whose URL is
# actually set, never a broken/placeholder link. NEXT_PUBLIC_ because
# they're read from a client component. See "Branded export architecture"
# in CLAUDE.md.
# NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
# NEXT_PUBLIC_SOCIAL_TIKTOK_URL=
# NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=
